rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // =========================================================================
    // BiotaElite 2.0 Production Storage Security Rules
    // =========================================================================
    // Public read access for approved media assets and documentation.
    // Write access requires authenticated staff membership verified against Firestore.
    // Strict MIME-type regex and file-size quotas enforced at the storage boundary.

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaffUser() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in
        ['super_admin', 'admin', 'editor', 'reviewer', 'data_manager'];
    }

    // Species Specimen Imagery (Max 15MB, Image types only)
    match /species/{speciesId}/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffUser()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)');
    }

    // Taxon Hierarchy Imagery & Diagrammatics (Max 10MB)
    match /taxa/{taxonId}/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffUser()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)');
    }

    // Curated Media Assets & Field Photography (Max 15MB)
    match /media/{mediaId}/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffUser()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)');
    }

    // Scientific Publications, Monograph PDFs & Literature Documents (Max 25MB)
    match /documents/{docId}/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffUser()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
    }

    // Default Fallback: Explicit Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
