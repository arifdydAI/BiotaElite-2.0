# ==============================================================================
# BiotaElite 2.0 — Environment Configuration Reference
# ==============================================================================
# For local development:
#   Copy this file to `.env.local` and configure your credentials.
#   If Firebase credentials are not provided or VITE_USE_LOCAL_FALLBACK=true,
#   the application runs safely in development mode using local storage.
#
# For production deployment (Vercel):
#   Set these environment variables in your Vercel Project Settings:
#   Settings -> Environment Variables -> Production / Preview / Development
# ==============================================================================

# Firebase Web App Configuration (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=biotaelite-biodiversity.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=biotaelite-biodiversity
VITE_FIREBASE_STORAGE_BUCKET=biotaelite-biodiversity.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Mode Control:
# Set to 'false' in production Vercel environments to enable live Firebase Auth & Firestore.
# Set to 'true' during offline development or local testing without Firebase services.
VITE_USE_LOCAL_FALLBACK=true
