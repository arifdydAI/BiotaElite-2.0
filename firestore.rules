rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Role-Based Access Control Helper Functions
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAnyRole(roles) {
      return isSignedIn() && getUserData().role in roles;
    }

    function isStaff() {
      return isAnyRole(['super_admin', 'admin', 'editor', 'reviewer', 'data_manager']);
    }

    function isVerifier() {
      return isAnyRole(['super_admin', 'admin', 'reviewer']);
    }

    function isAdmin() {
      return isAnyRole(['super_admin', 'admin']);
    }

    // =========================================================================
    // Core Biodiversity Collections
    // =========================================================================

    // Species Catalog: Public reads published records; Staff reads all drafts/reviews
    match /species/{speciesId} {
      allow read: if resource.data.isPublished == true || isStaff();
      allow create: if isAnyRole(['super_admin', 'admin', 'editor', 'data_manager']);
      allow update: if isStaff() && (
        // Only verifiers (super_admin, admin, reviewer) can change status to verified or published
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'isPublished', 'lifecycleStatus']))
        || isVerifier()
      );
      allow delete: if isAdmin();
    }

    // Species Drafts: Working workspace for curated species submissions
    match /speciesDrafts/{draftId} {
      allow read, write: if isStaff();
    }

    // Taxonomy Tree: Public read; Staff write
    match /taxa/{taxonId} {
      allow read: if true;
      allow write: if isAnyRole(['super_admin', 'admin', 'data_manager', 'editor']);
    }

    // Scientific Names & Synonyms: Public read; Staff write
    match /scientificNames/{nameId} {
      allow read: if true;
      allow write: if isAnyRole(['super_admin', 'admin', 'data_manager', 'editor']);
    }

    // Literature References & Monographs: Public read; Staff write
    match /references/{refId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Dichotomous Identification Keys: Public read; Staff write
    match /identificationKeys/{keyId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Media Provenance Metadata: Public read; Staff write
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // =========================================================================
    // Editorial Review & Governance Workflows
    // =========================================================================

    // Peer Reviews: Staff read/create; Verifiers update; Admins delete
    match /reviews/{reviewId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isVerifier();
      allow delete: if isAdmin();
    }

    // Batch Ingestion Records
    match /importBatches/{batchId} {
      allow read: if isStaff();
      allow write: if isAnyRole(['super_admin', 'admin', 'data_manager']);
    }

    // Conflict Resolution Records
    match /conflicts/{conflictId} {
      allow read: if isStaff();
      allow write: if isAnyRole(['super_admin', 'admin', 'data_manager']);
    }

    // =========================================================================
    // Audit Logging (Append-Only Immutable Trail)
    // =========================================================================

    match /auditLogs/{logId} {
      // Readable exclusively by administrators
      allow read: if isAdmin();
      // Appended by authenticated staff members recording their own actions
      allow create: if isStaff() && request.resource.data.actorId == request.auth.uid;
      // Strictly immutable: historical audit records can never be modified or deleted
      allow update, delete: if false;
    }

    // =========================================================================
    // User Management & Security Governance
    // =========================================================================

    match /users/{userId} {
      // User can read their own profile; Admins can read all profiles
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Safe creation: newly signed-in users can create their own profile with default role 'public_user'
      // Self-promotion to staff/admin roles on document creation is strictly rejected
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !('role' in request.resource.data) || request.resource.data.role == 'public_user'
      );

      // Controlled updates:
      // 1. Super admin can update any profile and assign any role
      // 2. Admin can update users, but cannot touch super_admin accounts or assign super_admin
      // 3. Normal users can update non-sensitive profile fields, but NEVER change role, permissions, or isActive
      allow update: if (
        hasRole('super_admin') ||
        (hasRole('admin') && resource.data.role != 'super_admin' && request.resource.data.role != 'super_admin') ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'isActive']))
      );

      // Deletion is restricted to Super Admin only
      allow delete: if hasRole('super_admin');
    }

    // System Settings & Configuration (Super Admin Only)
    match /adminSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin');
    }

    // Role Definitions & System Content
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if hasRole('super_admin');
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // Default Fallback: Explicit Deny
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
